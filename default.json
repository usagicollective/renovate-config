{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>usagicollective/renovate-config:base"],
  "schedule": ["* * * * 6"],
  "lockFileMaintenance": {
    "schedule": ["* * * * 6"]
  },
  "packageRules": [
    {
      "description": "週次更新では major 以外を 1 本の PR にまとめる。major は automerge しないため含めない（含めるとグループ全体が automerge されなくなる）。脆弱性の更新は vulnerabilityAlerts の既定により別 PR で随時出る",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "groupName": "all non-major dependencies",
      "groupSlug": "all-non-major"
    }
  ]
}
