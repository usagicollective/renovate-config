{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "dependencyDashboard": false,
  "timezone": "Asia/Tokyo",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "npm は公開から 3 日待ってから更新を出す。各リポジトリの .npmrc の min-release-age=3 と対にする。config:best-practices が extends する security:minimumReleaseAgeNpm と同値だが、上流が変えても両者がずれないよう明示する",
      "matchDatasources": ["npm"],
      "matchUpdateTypes": ["major", "minor", "patch"],
      "minimumReleaseAge": "3 days",
      "internalChecksFilter": "strict"
    },
    {
      "description": "major は人間が判断する",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "routine な更新は automerge に任せる",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true
    },
    {
      "description": "lockfile 全体の更新も automerge の対象にする",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "automerge": true
    },
    {
      "description": "wrangler と workers-types は peer 依存で結合しているためまとめて更新する",
      "matchPackageNames": ["wrangler", "@cloudflare/workers-types"],
      "groupName": "cloudflare",
      "separateMajorMinor": false
    },
    {
      "matchPackageNames": ["/eslint/"],
      "addLabels": ["dependencies:lint"]
    },
    {
      "matchPackageNames": ["/prettier/"],
      "addLabels": ["dependencies:format"]
    }
  ]
}
