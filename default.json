{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "dependencyDashboard": false,
  "timezone": "Asia/Tokyo",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "自 org の action は digest を固定せず main を追わせる。同じ org なので pin の防御効果が無く、main が動くたびに全リポジトリへ更新 PR が出る（action リポジトリ自身では merge するたびに次の PR が出る無限ループになる）",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["usagicollective/actions"],
      "enabled": false
    },
    {
      "description": "major は人間が判断する",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "routine な更新は automerge に任せる",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true
    },
    {
      "description": "lockfile 全体の更新も automerge の対象にする",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "automerge": true
    },
    {
      "description": "wrangler と workers-types は peer 依存で結合しているためまとめて更新する",
      "matchPackageNames": ["wrangler", "@cloudflare/workers-types"],
      "groupName": "cloudflare",
      "separateMajorMinor": false
    },
    {
      "matchPackageNames": ["/eslint/"],
      "addLabels": ["dependencies:lint"]
    },
    {
      "matchPackageNames": ["/prettier/"],
      "addLabels": ["dependencies:format"]
    }
  ]
}
