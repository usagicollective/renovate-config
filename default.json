{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:best-practices"],
  "dependencyDashboard": false,
  "timezone": "Asia/Tokyo",
  "labels": ["dependencies"],
  "packageRules": [
    {
      "description": "自 Org の action は digest を固定せず main を追わせる。（actions リポジトリ自身では merge するたびに次の PR が出て無限ループになる）",
      "matchManagers": ["github-actions"],
      "matchDepNames": ["usagicollective/actions"],
      "enabled": false
    },
    {
      "description": "major は automerge しない",
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "minor 以下は automerge",
      "matchUpdateTypes": ["minor", "patch", "pin", "pinDigest", "digest"],
      "automerge": true
    },
    {
      "description": "lockfile 全体の更新も automerge",
      "matchUpdateTypes": ["lockFileMaintenance"],
      "automerge": true
    },
    {
      "description": "wrangler と workers-types は peer 依存で結合しているためまとめて更新する",
      "matchPackageNames": ["wrangler", "@cloudflare/workers-types"],
      "groupName": "cloudflare",
      "separateMajorMinor": false
    },
    {
      "description": "astro と @astrojs/* は peer で結合しているためまとめて更新する",
      "matchPackageNames": ["astro", "/^@astrojs\\//"],
      "groupName": "astro"
    },
    {
      "description": "@lucide/astro と lucide-preact は同じモノレポの同時リリースのためまとめて更新する",
      "matchPackageNames": ["@lucide/astro", "lucide-preact"],
      "groupName": "lucide"
    },
    {
      "matchPackageNames": ["/eslint/"],
      "addLabels": ["dependencies:lint"]
    },
    {
      "matchPackageNames": ["/prettier/"],
      "addLabels": ["dependencies:format"]
    }
  ]
}
